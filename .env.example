# Copy to .env and fill in. See SPEC §4 for every key and its default.

# Target repo (your own fork or clone, containing .rematch/target.toml)
TARGET_REPO=
# Commit used for the vanilla build (answer key)
TARGET_PIN=
# Optional comma-separated override of target.toml default_versions (first is primary)
TARGET_VERSIONS=

# Optional argv prefix for target toolchain commands; {cwd} becomes the working directory.
# Example: docker exec -i -w {cwd} <container>
TOOLCHAIN_EXEC=
BUILD_TIMEOUT_SEC=3600

# Defaults: REMATCH_DB=./var/<target name>.sqlite, REMATCH_VAR=./var, REMATCH_WORKDIR=~/.rematch/work
REMATCH_DB=
REMATCH_VAR=./var
REMATCH_WORKDIR=~/.rematch/work

CLAUDE_BIN=claude
WORKER_AUTH_MODE=subscription
# API mode only. Never commit a real key.
ANTHROPIC_API_KEY=
